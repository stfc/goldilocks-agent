# Only used by `npm run build:stfc-cloud-internal` (Vite's `--mode
# stfc-cloud-internal`) -- the local/desktop Docker build (`npm run build`)
# never loads this file. For direct STFC-internal access to a dedicated VM
# (no nginx in front to rewrite an `/agent/` prefix), so VITE_BASE_PATH is
# left at vite.config's default root `/` -- unlike `.env.stfc-cloud-public`,
# which bakes in `/agent/` for the shared-domain subpath deployment. Same
# §19.1/§19.2 shared deployment UI flags (sidebar/history disabled, session
# state tab-scoped) as the public variant.
VITE_SHARED_DEPLOYMENT=1
