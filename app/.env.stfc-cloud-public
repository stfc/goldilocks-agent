# Only used by `npm run build:stfc-cloud-public` (Vite's `--mode
# stfc-cloud-public`) -- the local/desktop Docker build (`npm run build`)
# never loads this file. For the shared-domain deployment once nginx/TLS/
# subdomain land (design doc §19.3: subpath, not subdomain), where nginx
# passes `/agent/*` through unstripped -- see `.env.stfc-cloud-internal` for
# the direct-access variant used before that's ready. §19.1/§19.2 shared
# deployment UI flags (sidebar/history disabled, session state tab-scoped)
# apply to both variants.
VITE_BASE_PATH=/agent/
VITE_SHARED_DEPLOYMENT=1
