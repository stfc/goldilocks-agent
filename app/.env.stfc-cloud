# Only used by `npm run build:stfc-cloud` (Vite's `--mode stfc-cloud`): the web
# build for the STFC Cloud shared deployment, served at `/` on
# workbench.goldilocks.ac.uk (deploy/stfc-cloud/README.md). It turns on the
# shared-deployment UI (design doc §19.1/§19.2): no sidebar or history, state
# scoped to the browser tab. The local/desktop build (`npm run build`) never
# loads this file.
VITE_SHARED_DEPLOYMENT=1
