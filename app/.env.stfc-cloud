# Only used by `npm run build:stfc-cloud` (Vite's `--mode stfc-cloud`) --
# the local/desktop Docker build (`npm run build`) never loads this file.
# See design doc §19.3 (subpath, not subdomain) and §19.1/§19.2 (no account
# system -- sidebar/history disabled, session state is tab-scoped).
VITE_BASE_PATH=/agent/
VITE_SHARED_DEPLOYMENT=1
